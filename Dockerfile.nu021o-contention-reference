FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git make gcc g++ libc6-dev pkg-config libelf-dev gcc-avr avr-libc binutils-avr && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY . .
RUN set -eux; make -C simavr RELEASE=1 all; \
 cc -std=c11 -O2 -Wall -Wextra -Werror -Isimavr/sim tests/weightos_nu021o_contention_probe.c -Lsimavr/obj-x86_64-linux-gnu -lsimavr -lelf -o /tmp/probe; \
 avr-gcc -mmcu=atmega328p -nostdlib -Wl,-e,start -x assembler-with-cpp tests/weightos_nu021o_contention.S -o /tmp/o.elf; \
 avr-objcopy -O binary -j .text /tmp/o.elf /tmp/o.bin; sha256sum /tmp/o.bin; \
 echo NU021O_WORDS_BEGIN; od -An -tu2 -v /tmp/o.bin | xargs; echo NU021O_WORDS_END; \
 LD_LIBRARY_PATH=simavr/obj-x86_64-linux-gnu /tmp/probe /tmp/o.bin; echo NU021O_REFERENCE_PASS
CMD ["/bin/sh","-c","exit 0"]
