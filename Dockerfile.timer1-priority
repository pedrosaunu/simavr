# Independent, *seeded-boundary* Timer1 priority reference.
# Not guest-driven interrupt generation, full ISR latency or silicon.
FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates git make gcc g++ libc6-dev pkg-config libelf-dev \
  gcc-avr avr-libc binutils-avr && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY . .
RUN set -eux; \
  make -C simavr RELEASE=1 all; \
  cc -std=c11 -O2 -Wall -Wextra -Werror -Isimavr/sim \
   tests/weightos_timer1_pending_boundary.c \
   -Lsimavr/obj-x86_64-linux-gnu -lsimavr -lelf \
   -o /tmp/timer1_pending_boundary; \
  LD_LIBRARY_PATH=simavr/obj-x86_64-linux-gnu \
   /tmp/timer1_pending_boundary; \
  echo TIMER1_PRIORITY_SEEDED_SIMAVR_BOUNDARY_PASS
CMD ["/bin/sh","-c","exit 0"]
