# NU-019B independent OCF1B hardware callback vs real AVR W1C.
# Only simulated timing, not physical silicon same-edge priority.
FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
 make gcc g++ libc6-dev pkg-config libelf-dev gcc-avr binutils-avr avr-libc \
 python3 ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY . .
RUN set -eu; \
 make -C simavr RELEASE=1 all; \
 cc -std=c11 -O2 -Wall -Wextra -Werror -Isimavr/sim \
   tests/weightos_timer1_nu019_same_cycle_probe.c \
   -Lsimavr/obj-x86_64-linux-gnu -lsimavr -lelf -o /tmp/nu019b_probe; \
 : > /tmp/nu019b-selected.raw; \
 : > /tmp/nu019b-sweep.raw; \
 for ocr in 0 1 2 3 4 5 6 7 8; do \
  for nops in 0 1 2 3 4 5 6 7 8; do \
   avr-gcc -mmcu=atmega328p -nostdlib -Wl,-e,start \
     -DNU019_OCR_B=$ocr -DNU019_NOP_COUNT=$nops \
     -x assembler-with-cpp tests/weightos_timer1_nu019b_ocf1b_phase.S \
     -o /tmp/nu019b.elf; \
   avr-objcopy -O binary -j .text /tmp/nu019b.elf /tmp/nu019b.bin; \
   sha="$(sha256sum /tmp/nu019b.bin | cut -d' ' -f1)"; \
   printf 'NU019B_CASE_BEGIN ocr=%s nops=%s sha256=%s\n' "$ocr" "$nops" "$sha" >> /tmp/nu019b-sweep.raw; \
   case "$ocr:$nops" in 2:0|3:0|4:0|4:1) \
    printf 'NU019B_SELECTED_BEGIN ocr=%s nops=%s sha256=%s\n' "$ocr" "$nops" "$sha" >> /tmp/nu019b-selected.raw; \
    printf 'NU019_WORDS %s\n' "$(od -An -tu2 -v /tmp/nu019b.bin | xargs)" >> /tmp/nu019b-selected.raw ;; \
   esac; \
   LD_LIBRARY_PATH=simavr/obj-x86_64-linux-gnu \
     /tmp/nu019b_probe /tmp/nu019b.bin "$ocr" "$nops" \
     > /tmp/nu019b-current.raw 2>&1; \
   cat /tmp/nu019b-current.raw >> /tmp/nu019b-sweep.raw; \
   echo NU019B_CASE_END >> /tmp/nu019b-sweep.raw; \
   case "$ocr:$nops" in 2:0|3:0|4:0|4:1) \
    cat /tmp/nu019b-current.raw >> /tmp/nu019b-selected.raw; \
    echo NU019B_SELECTED_END >> /tmp/nu019b-selected.raw ;; \
   esac; \
  done; \
 done; \
 python3 tests/weightos_timer1_nu019b_sweep_audit.py /tmp/nu019b-sweep.raw > /tmp/nu019b-sweep-results.jsonl; \
 cat /tmp/nu019b-sweep-results.jsonl; \
 python3 tests/weightos_timer1_nu019b_selected_audit.py /tmp/nu019b-selected.raw; \
 echo NU019B_81_PROGRAMS_4_SELECTED_STRICT_PASS
CMD ["/bin/sh","-c","exit 0"]
