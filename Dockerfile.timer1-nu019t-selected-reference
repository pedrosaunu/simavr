# Four independent TOV1 before/equal/after programs; NOT real silicon.
FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
 gcc g++ make libc6-dev pkg-config libelf-dev gcc-avr avr-libc binutils-avr \
 python3 ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY . .
RUN set -eu; \
 make -C simavr RELEASE=1 all; \
 cc -std=c11 -O2 -Wall -Wextra -Werror -Isimavr/sim \
 tests/weightos_timer1_nu019t_overflow_probe.c \
 -Lsimavr/obj-x86_64-linux-gnu -lsimavr -lelf -o /tmp/nu019t_probe; \
 : > /tmp/nu019t-selected.raw; \
 for case in 253:0 253:1 253:2 254:0; do \
  low="$(echo "$case"|cut -d: -f1)"; \
  nops="$(echo "$case"|cut -d: -f2)"; \
  avr-gcc -mmcu=atmega328p -nostdlib -Wl,-e,start \
      -DNU019T_START_LOW=$low -DNU019T_NOP_COUNT=$nops \
      -x assembler-with-cpp tests/weightos_timer1_nu019t_overflow.S \
      -o /tmp/nu019t.elf; \
  avr-objcopy -O binary -j .text /tmp/nu019t.elf /tmp/nu019t.bin; \
  sha="$(sha256sum /tmp/nu019t.bin | cut -d' ' -f1)"; \
  printf 'NU019T_SELECTED_BEGIN low=%s nops=%s sha256=%s\n' "$low" "$nops" "$sha" >> /tmp/nu019t-selected.raw; \
  printf 'NU019T_WORDS %s\n' "$(od -An -tu2 -v /tmp/nu019t.bin | xargs)" >> /tmp/nu019t-selected.raw; \
  LD_LIBRARY_PATH=simavr/obj-x86_64-linux-gnu \
   /tmp/nu019t_probe /tmp/nu019t.bin "$low" "$nops" \
    >> /tmp/nu019t-selected.raw 2>&1; \
  echo NU019T_SELECTED_END >> /tmp/nu019t-selected.raw; \
 done; \
 python3 tests/weightos_timer1_nu019t_selected_audit.py /tmp/nu019t-selected.raw; \
 echo NU019T_SELECTED_4_REFERENCE_COMPLETE
CMD ["/bin/sh","-c","exit 0"]
