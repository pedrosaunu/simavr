# Six independent guest AVR binaries with external pin phase events. NO silicon.
FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
 make gcc g++ libc6-dev pkg-config libelf-dev gcc-avr binutils-avr avr-libc \
 python3 ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY . .
RUN set -eu; \
 make -C simavr RELEASE=1 all; \
 cc -std=c11 -O2 -Wall -Wextra -Werror -Isimavr/sim \
 tests/weightos_timer1_nu019c_icf1_probe.c \
 -Lsimavr/obj-x86_64-linux-gnu -lsimavr -lelf -o /tmp/nu019c_probe; \
 : >/tmp/nu019c-selected.raw; \
 for case in '0:0' '0:1' '0:2' '0:4' '2:3' '2:-1'; do \
  nops="$(echo "$case"|cut -d: -f1)"; \
  delay="$(echo "$case"|cut -d: -f2)"; \
  avr-gcc -mmcu=atmega328p -nostdlib -Wl,-e,start \
    -DNU019C_NOPS=$nops -x assembler-with-cpp \
    tests/weightos_timer1_nu019c_icf1.S -o /tmp/nu019c.elf; \
  avr-objcopy -O binary -j .text /tmp/nu019c.elf /tmp/nu019c.bin; \
  sha="$(sha256sum /tmp/nu019c.bin | cut -d' ' -f1)"; \
  printf 'NU019C_SELECTED_BEGIN nops=%s delay=%s sha256=%s\n' "$nops" "$delay" "$sha" >>/tmp/nu019c-selected.raw; \
  printf 'NU019C_WORDS %s\n' "$(od -An -tu2 -v /tmp/nu019c.bin | xargs)" >>/tmp/nu019c-selected.raw; \
  LD_LIBRARY_PATH=simavr/obj-x86_64-linux-gnu \
   /tmp/nu019c_probe /tmp/nu019c.bin "$nops" "$delay" >>/tmp/nu019c-selected.raw 2>&1; \
  echo NU019C_SELECTED_END >>/tmp/nu019c-selected.raw; \
 done; \
 if python3 tests/weightos_timer1_nu019c_selected_audit.py /tmp/nu019c-selected.raw; then \
   echo NU019C_SELECTED_6_GUEST_REFERENCE_COMPLETE; \
 else \
   echo NU019C_SELECTED_REFERENCE_RED; \
   tail -n 75 /tmp/nu019c-selected.raw; \
   exit 1; \
 fi
CMD ["/bin/sh","-c","exit 0"]
