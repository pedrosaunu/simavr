FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git make gcc g++ libc6-dev pkg-config libelf-dev gcc-avr avr-libc binutils-avr && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY . .
RUN make -C simavr RELEASE=1 all && cc -std=c11 -O2 -Wall -Wextra -Werror -Isimavr/sim tests/weightos_nu016se_modes_probe.c -Lsimavr/obj-x86_64-linux-gnu -lsimavr -lelf -o /tmp/probe
RUN set -eu; for mode in 0 4 5 6 7 12 14 15; do for cs in 6 7; do case $mode in 0) seed=65532;; 5) seed=252;; 6) seed=508;; 7) seed=1020;; *) seed=0;; esac; avr-gcc -mmcu=atmega328p -nostdlib -Wl,-e,start -DWGM=$mode -DCS=$cs -DSEED=$seed -x assembler-with-cpp tests/nu016se_t1_modes.S -o /tmp/t1.elf; avr-objcopy -O binary -j .text /tmp/t1.elf /tmp/t1.bin; sha256sum /tmp/t1.bin; LD_LIBRARY_PATH=simavr/obj-x86_64-linux-gnu /tmp/probe /tmp/t1.bin $mode $cs; done; done
CMD ["/bin/sh","-c","exit 0"]
