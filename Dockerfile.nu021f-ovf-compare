# NU-021F independent WGM0 Timer1 OVF+compare guest from RESET.
FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
 ca-certificates make gcc g++ libc6-dev pkg-config libelf-dev \
 gcc-avr avr-libc binutils-avr && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY . .
RUN set -eux; \
 make -C simavr RELEASE=1 all; \
 cc -std=c11 -O2 -Wall -Wextra -Werror -Isimavr/sim \
  tests/weightos_nu021f_ovf_compare_probe.c \
  -Lsimavr/obj-x86_64-linux-gnu -lsimavr -lelf -o /tmp/nu021f_probe; \
 for mask in 1 3 7; do \
  avr-gcc -mmcu=atmega328p -nostdlib -Wl,-e,start -DIRQ_MASK=$mask \
   -x assembler-with-cpp tests/weightos_nu021f_ovf_compare.S \
   -o /tmp/nu021f-$mask.elf; \
  avr-objcopy -O binary -j .text /tmp/nu021f-$mask.elf /tmp/nu021f-$mask.bin; \
  sha256sum /tmp/nu021f-$mask.bin; \
  echo NU021F_WORDS_BEGIN_$mask; \
  od -An -tu2 -v /tmp/nu021f-$mask.bin | xargs; \
  echo NU021F_WORDS_END_$mask; \
  LD_LIBRARY_PATH=simavr/obj-x86_64-linux-gnu \
   /tmp/nu021f_probe /tmp/nu021f-$mask.bin $mask; \
 done; \
 echo NU021F_REFERENCE_ALL_MASKS_PASS
CMD ["/bin/sh","-c","exit 0"]
