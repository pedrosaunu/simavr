FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git make gcc g++ libc6-dev pkg-config libelf-dev gcc-avr avr-libc binutils-avr python3 && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY . .
RUN make -C simavr RELEASE=1 all && cc -std=c11 -O2 -Wall -Wextra -Werror -Isimavr/sim tests/weightos_nu016l_probe.c -Lsimavr/obj-x86_64-linux-gnu -lsimavr -lelf -o /tmp/probe
RUN python3 tests/nu016o_generate.py /tmp/matrix
RUN set -eu; for id in $(seq 1000 1035); do avr-gcc -mmcu=atmega328p -nostdlib -Wl,-e,start -x assembler-with-cpp /tmp/matrix/case-$id.S -o /tmp/pwm.elf; avr-objcopy -O binary -j .text /tmp/pwm.elf /tmp/pwm.bin; NU016L_PRESCALED=1 NU016_BUS_PHASE=2 LD_LIBRARY_PATH=simavr/obj-x86_64-linux-gnu /tmp/probe /tmp/pwm.bin >/tmp/trace 2>/tmp/events; python3 tests/nu016l_summarize.py "$id" /tmp/pwm.bin /tmp/trace; NU016O_INDIRECT=1 NU016L_PRESCALED=1 NU016_BUS_PHASE=2 LD_LIBRARY_PATH=simavr/obj-x86_64-linux-gnu /tmp/probe /tmp/pwm.bin >/tmp/candidate 2>/tmp/events; python3 tests/nu016l_summarize.py "$id" /tmp/pwm.bin /tmp/candidate | sed "s/NU016L REF/NU016O CANDIDATE/"; if [ "$id" = 1013 ]; then sed -n 's/^NU016F ROW /NU016O BASE_ROW /p' /tmp/trace; sed -n 's/^NU016F ROW /NU016O CAND_ROW /p' /tmp/candidate; fi; done
CMD ["/bin/sh","-c","exit 0"]
