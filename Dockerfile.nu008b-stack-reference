FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git make gcc g++ libc6-dev pkg-config libelf-dev gcc-avr avr-libc binutils-avr && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY . .
RUN set -eux; make -C simavr RELEASE=1 all; \
 cc -std=c11 -O2 -Wall -Wextra -Werror -Isimavr/sim tests/weightos_nu008b_stack_probe.c -Lsimavr/obj-x86_64-linux-gnu -lsimavr -lelf -o /tmp/probe; \
 for top in 319 2303; do \
 avr-gcc -mmcu=atmega328p -nostdlib -Wl,-e,start -DSTACK_TOP=$top -x assembler-with-cpp tests/weightos_nu008b_stack.S -o /tmp/stack.elf; \
 avr-objcopy -O binary -j .text /tmp/stack.elf /tmp/stack-$top.bin; sha256sum /tmp/stack-$top.bin; \
 echo NU008B_WORDS_BEGIN_$top; od -An -tu2 -v /tmp/stack-$top.bin | xargs; echo NU008B_WORDS_END_$top; \
 LD_LIBRARY_PATH=simavr/obj-x86_64-linux-gnu /tmp/probe /tmp/stack-$top.bin $top; done
CMD ["/bin/sh","-c","exit 0"]
