FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git make gcc g++ libc6-dev pkg-config libelf-dev gcc-avr avr-libc binutils-avr && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY . .
RUN set -eux; make -C simavr RELEASE=1 all; \
 cc -std=c11 -O2 -Wall -Wextra -Werror -Isimavr/sim tests/weightos_nu020b_preempted_probe.c -Lsimavr/obj-x86_64-linux-gnu -lsimavr -lelf -o /tmp/probe; \
 avr-gcc -mmcu=atmega328p -nostdlib -Wl,-e,start -x assembler-with-cpp tests/weightos_nu020b_preempted.S -o /tmp/b.elf; \
 avr-objcopy -O binary -j .text /tmp/b.elf /tmp/b.bin; sha256sum /tmp/b.bin; \
 echo NU020B_WORDS_BEGIN; od -An -tu2 -v /tmp/b.bin | xargs; echo NU020B_WORDS_END; \
 LD_LIBRARY_PATH=simavr/obj-x86_64-linux-gnu /tmp/probe /tmp/b.bin; echo NU020B_REFERENCE_PASS
CMD ["/bin/sh","-c","exit 0"]
